{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    // Root build and tooling files
    "*.slnx": "global.json, Directory.Build.props, Directory.Build.targets, Directory.Packages.props",
    ".gitignore": ".gitattributes, .editorconfig, .dockerignore",
    "README.md": "LICENSE*, CHANGELOG*, CONTRIBUTING*",
    "Dockerfile": ".dockerignore, docker-compose*.yml, compose*.yml",

    // .NET
    "*.csproj": "xunit.runner.json, packages.lock.json",
    "appsettings.json": "appsettings.*.json",
    "*.cs": "$(capture).*.cs",

    // Web (Stage 2)
    "package.json": "package-lock.json, .nvmrc, .npmrc, tsconfig*.json, vite.config.*, vitest.config.*, eslint.config.*, .prettier*, components.json",
    "*.ts": "$(capture).test.ts, $(capture).spec.ts",
    "*.tsx": "$(capture).test.tsx, $(capture).spec.tsx"
  }
}
