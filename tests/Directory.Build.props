<Project>
  <!-- The repository's shared settings (target framework, analyzers, warnings as errors). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Code coverage for every test project, as a Microsoft.Testing.Platform extension. It's off unless
       a run asks for it, as ./scripts/test-all-with-coverage.sh does. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
