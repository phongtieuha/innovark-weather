{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client", "@testing-library/jest-dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@web/*": ["../../../src/Innovark.Weather.UI/Innovark.Weather.Web/*"],
      "@/*": ["../../../src/Innovark.Weather.UI/Innovark.Weather.Components/src/*"]
    }
  },
  "include": [
    "Pages",
    "client",
    "vitest.config.ts",
    "vitest.setup.ts",
    "../../../src/Innovark.Weather.UI/Innovark.Weather.Web/client/types.d.ts"
  ],
  "exclude": ["node_modules", "bin", "obj"]
}
