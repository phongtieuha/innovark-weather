{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": true, "UseUtcTimestamp": true, "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ" }
    }
  },
  "AllowedHosts": "*",
  "OpenMeteo": {
    "BaseUrl": "https://archive-api.open-meteo.com/",
    "Latitude": 10.762622,
    "Longitude": 106.660172,
    "Resilience": {
      "TotalRequestTimeout": { "Timeout": "00:00:15" },
      "AttemptTimeout": { "Timeout": "00:00:05" },
      "Retry": { "MaxRetryAttempts": 2, "Delay": "00:00:00.500" },
      "CircuitBreaker": { "SamplingDuration": "00:00:30", "BreakDuration": "00:00:15" }
    }
  }
}
