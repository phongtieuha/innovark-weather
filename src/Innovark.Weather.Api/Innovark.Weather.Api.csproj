<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Writes the OpenAPI document to docs/openapi on each Debug build, so API changes show up as a
       diff and the web project's Kiota client is generated from it. Release (e.g. the Docker image)
       skips it. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../docs/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments Condition="'$(Configuration)' != 'Debug'">false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Innovark.Weather.Application\Innovark.Weather.Application.csproj" />
    <ProjectReference Include="..\Innovark.Weather.Infrastructure\Innovark.Weather.Infrastructure.csproj" />
  </ItemGroup>

</Project>
