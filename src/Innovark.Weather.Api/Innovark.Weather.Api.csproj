<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Writes the OpenAPI document to openapi.json next to this file on each Debug build, so API
       changes show up as a diff and the web project's Kiota client is generated from it. Release
       (e.g. the Docker image) skips it. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(Configuration)' != 'Debug'">false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <!-- A build artifact for the generated clients, not app content: not copied to the output or
       published, and not watched (each Debug build rewrites it, which would restart dotnet watch). -->
  <ItemGroup>
    <Content Update="openapi.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Watch="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Innovark.Weather.Application\Innovark.Weather.Application.csproj" />
    <ProjectReference Include="..\Innovark.Weather.Infrastructure\Innovark.Weather.Infrastructure.csproj" />
  </ItemGroup>

</Project>
