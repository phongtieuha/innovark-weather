<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Innovark Weather</title>
    @* "~/" renders the app's path base, so API calls resolved against it work under a sub-path. *@
    <base href="~/">
    <link rel="icon" href="data:," />
    @await RenderSectionAsync("Styles", false)
</head>

<body>
    <div id="app"></div>
    @RenderBody()
</body>

</html>
