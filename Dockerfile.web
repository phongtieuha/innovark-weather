# syntax=docker/dockerfile:1

# The web app (src/Innovark.Weather.UI/Innovark.Weather.Web). A Release publish runs `bun run build`
# (Vite) for the page's bundle, so the build stage needs bun as well as the .NET SDK.
# Build: docker build -f Dockerfile.web -t innovark-weather-web .

# bun for the build platform, copied into the SDK image below (the bundle is the same on any platform).
FROM --platform=$BUILDPLATFORM oven/bun:1.3.10 AS bun

# Build on the machine's own architecture and cross-compile for the target, as in ./Dockerfile.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /src

# Restore first, from project files only, so the package layers are cached until they change.
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Innovark.Weather.UI/Innovark.Weather.Web/*.csproj src/Innovark.Weather.UI/Innovark.Weather.Web/
RUN dotnet restore src/Innovark.Weather.UI/Innovark.Weather.Web/Innovark.Weather.Web.csproj -a $TARGETARCH

# The bun workspace's manifests and lockfile; --frozen-lockfile fails the build if they disagree. The
# whole workspace is installed: the build tools (Vite, Tailwind) are the workspace root's dependencies.
COPY src/Innovark.Weather.UI/package.json src/Innovark.Weather.UI/bun.lock src/Innovark.Weather.UI/
COPY src/Innovark.Weather.UI/Innovark.Weather.Components/package.json src/Innovark.Weather.UI/Innovark.Weather.Components/
COPY src/Innovark.Weather.UI/Innovark.Weather.Storybook/package.json src/Innovark.Weather.UI/Innovark.Weather.Storybook/
COPY src/Innovark.Weather.UI/Innovark.Weather.Web/package.json src/Innovark.Weather.UI/Innovark.Weather.Web/
RUN cd src/Innovark.Weather.UI && bun install --frozen-lockfile

COPY src/Innovark.Weather.UI/ src/Innovark.Weather.UI/
RUN dotnet publish src/Innovark.Weather.UI/Innovark.Weather.Web/Innovark.Weather.Web.csproj \
    -c Release -a $TARGETARCH --no-restore \
    -o /app/publish /p:UseAppHost=false

# Chiseled: Ubuntu with only what .NET needs. No shell, no package manager, non-root by default.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS runtime
WORKDIR /app
COPY --from=build /app/publish .

# DOTNET_EnableDiagnostics=0 stops the runtime creating IPC files, so the root filesystem can be
# read-only (read_only in docker-compose).
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER $APP_UID

# Exec form, so the app is PID 1 and receives SIGTERM directly for a graceful shutdown.
ENTRYPOINT ["dotnet", "Innovark.Weather.Web.dll"]
