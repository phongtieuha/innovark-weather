<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for Microsoft.Testing.Extensions.CodeCoverage, used by
     ./scripts/test-all-with-coverage.sh. Patterns are regular expressions. -->
<Configuration>
  <CodeCoverage>
    <!-- Only the apps and libraries in src/, not the tests or third-party assemblies. -->
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Innovark\.Weather\.(Api|Application|Infrastructure|Web)\.dll$</ModulePath>
      </Include>
    </ModulePaths>

    <!-- Generated code: the Kiota client (marked [GeneratedCode]), and code the compiler or source
         generators write (Razor views, regex, OpenAPI, logging), which lives under obj/. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
        <Source>.*[\\/]Innovark\.Weather\.Web[\\/]WeatherApi[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
